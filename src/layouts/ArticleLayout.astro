---
import BaseLayout from './BaseLayout.astro';
import WikiLayout from './WikiLayout.astro';
import LastUpdated from '../components/article/LastUpdated.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import CommentsSection from '../components/comments/CommentsSection';
import Box26 from '../components/article/Box26.astro';
import { articleId, guidesIndexPath } from '../lib/paths';
import { getGuidesSortedByUpdate, getPopularGuides } from '../lib/guides';
import WikiInPageToc from '../components/layout/WikiInPageToc.astro';
import type { InPageTocItem } from '../components/layout/WikiInPageToc.astro';

interface Props {
  title: string;
  description: string;
  game: string;
  slug: string;
  updatedAt: Date;
  publishedAt: Date;
  inPageToc?: InPageTocItem[];
  /** 下書きプレビュー: noindex・コメント非表示・帯表示 */
  draftPreview?: boolean;
  showLead?: boolean;
}

const {
  title,
  description,
  game,
  slug,
  updatedAt,
  publishedAt,
  inPageToc,
  draftPreview = false,
  showLead = true,
} = Astro.props;
const id = articleId(game, slug);
const canonical = new URL(Astro.url.pathname, Astro.site);
const rankItems = await getPopularGuides(game, 10);
const guideItems = await getGuidesSortedByUpdate(game);
---

<BaseLayout title={title} description={description} game={game} noindex={draftPreview}>
  <JsonLd
    title={title}
    description={description}
    url={canonical.href}
    datePublished={publishedAt}
    dateModified={updatedAt}
  />
  <WikiLayout rankItems={rankItems} guideItems={guideItems}>
    <div class="wiki-stack">
      <article class="content-panel wiki-stack-block">
        <header class="mb-6 border-b border-[#ccc] pb-4">
          {
            draftPreview && (
              <p class="mb-3 rounded border border-amber-400 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-950">
                下書きプレビュー（未公開・検索対象外）
              </p>
            )
          }
          <nav class="breadcrumb mb-2" aria-label="パンくず">
            <a href={guidesIndexPath(game)}>攻略記事</a>
            <span class="breadcrumb-sep" aria-hidden="true">&gt;</span>
            <span class="breadcrumb-current">{title}</span>
          </nav>
          <h1 class="page-title">{title}</h1>
          <LastUpdated date={updatedAt} publishedAt={publishedAt} />
          <Box26 game={game} />
          {showLead && <p class="lead">{description}</p>}
        </header>

        <div class="article-prose mt-4">
          {inPageToc && inPageToc.length > 0 && <WikiInPageToc items={inPageToc} />}
          <slot />
        </div>

      </article>

      {
        !draftPreview && (
          <section class="content-panel wiki-stack-block" aria-label="コメント">
            <CommentsSection client:load articleId={id} />
          </section>
        )
      }
    </div>
  </WikiLayout>
</BaseLayout>
