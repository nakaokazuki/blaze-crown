---
import type { GuideListItem } from '../lib/guides';
import SidebarRankBoard from '../components/layout/SidebarRankBoard.astro';
import SidebarGuideList from '../components/layout/SidebarGuideList.astro';
interface Props {
  rankItems: GuideListItem[];
  guideItems?: GuideListItem[];
}

const { rankItems, guideItems = [] } = Astro.props;
---

<div class="wiki-layout">
  <div class="wiki-col-left wiki-col-left-stack">
    <SidebarRankBoard items={rankItems} />
    <SidebarGuideList items={guideItems} />
  </div>
  <div class="wiki-col-right wiki-col-right-stack">
    <slot />
  </div>
</div>
