---
interface Props {
  characterName: string;
}

const { characterName } = Astro.props;
const reviewHeading = `${characterName}の評価`;
const placeholder = '今後追記予定';
---

<div class="wiki-char-wiki wiki-char-wiki-full mt-8">
  <section id="section-review" class="wiki-char-section">
    <h2 class="section-title">{reviewHeading}</h2>
    <p>{placeholder}</p>
  </section>

  <section id="section-deck" class="wiki-char-section mt-6">
    <h3 class="section-title">おすすめデッキ</h3>
    <p>{placeholder}</p>
  </section>

  <section id="section-tips" class="wiki-char-section mt-6">
    <h3 class="section-title">使い方のコツ</h3>
    <p>{placeholder}</p>
  </section>
</div>
