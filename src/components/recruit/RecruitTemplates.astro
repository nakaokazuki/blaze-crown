---
import { loadRecruitTemplates } from '../../lib/recruitTemplates';
import { SITE_CONTACT_EMAIL } from '../../lib/constants';

const templates = loadRecruitTemplates();
const mailto = `mailto:${SITE_CONTACT_EMAIL}?subject=${encodeURIComponent('協力者募集')}`;
const defaultBody = templates[0]?.body ?? '';
---

<section class="wiki-recruit-templates not-prose wiki-stack-block mt-8" aria-labelledby="recruit-templates-heading">
  <h2 id="recruit-templates-heading" class="section-title">送信テンプレート</h2>

  <p class="mt-3 text-sm leading-relaxed text-[#333]">
    下の本文をコピーし、<a href={mailto}>{SITE_CONTACT_EMAIL}</a> へ送信してください（件名に「協力者募集」）。
  </p>

  <label for="recruit-template-select" class="mt-4 block font-bold text-[var(--g8-text)]">
    テンプレートの種類
  </label>
  <select id="recruit-template-select" class="wiki-recruit-template-select mt-2 w-full max-w-xl">
    {
      templates.map((t, index) => (
        <option value={index}>{t.label}</option>
      ))
    }
  </select>

  <textarea
    id="recruit-template-body"
    class="wiki-recruit-template-body mt-4 w-full font-mono text-sm leading-relaxed"
    rows={18}
    spellcheck="false"
    aria-label="テンプレート本文">{defaultBody}</textarea>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button type="button" id="recruit-template-copy" class="wiki-recruit-template-copy">
      全文をコピー
    </button>
    <output id="recruit-template-copy-status" class="text-sm text-[#666]" for="recruit-template-copy" />
  </div>
</section>

<script define:vars={{ templates }}>
  const select = document.getElementById('recruit-template-select');
  const body = document.getElementById('recruit-template-body');
  const copyBtn = document.getElementById('recruit-template-copy');
  const status = document.getElementById('recruit-template-copy-status');

  if (select && body && copyBtn && status && Array.isArray(templates)) {
    select.addEventListener('change', () => {
      const idx = Number(select.value);
      const item = templates[idx];
      if (item?.body) body.value = item.body;
      status.textContent = '';
    });

    copyBtn.addEventListener('click', async () => {
      const text = body.value;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = 'コピーしました';
      } catch {
        body.focus();
        body.select();
        const ok = document.execCommand('copy');
        status.textContent = ok ? 'コピーしました' : 'コピーに失敗しました。本文を選択して手動でコピーしてください。';
      }
    });
  }
</script>
